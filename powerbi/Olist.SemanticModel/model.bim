{
  "name": "Olist Commerce Analytics",
  "compatibilityLevel": 1601,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "Orders",
        "columns": [
          {
            "name": "Order ID",
            "dataType": "int64",
            "sourceColumn": "Order ID",
            "summarizeBy": "none",
            "isHidden": true,
            "description": "Compact internal key. Original source identifier is preserved in SourceKeys/Order_ID_mapping.csv."
          },
          {
            "name": "Customer ID",
            "dataType": "int64",
            "sourceColumn": "Customer ID",
            "summarizeBy": "none",
            "isHidden": true,
            "description": "Compact internal key. Original source identifier is preserved in SourceKeys/Customer_ID_mapping.csv."
          },
          {
            "name": "Purchase Date",
            "dataType": "dateTime",
            "sourceColumn": "Purchase Date",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy"
          },
          {
            "name": "Status",
            "dataType": "string",
            "sourceColumn": "Status",
            "summarizeBy": "none"
          },
          {
            "name": "State",
            "dataType": "string",
            "sourceColumn": "State",
            "summarizeBy": "none",
            "description": "Brazilian customer state abbreviation, e.g. SP = São Paulo."
          },
          {
            "name": "City",
            "dataType": "string",
            "sourceColumn": "City",
            "summarizeBy": "none"
          },
          {
            "name": "Delivery Days",
            "dataType": "double",
            "sourceColumn": "Delivery Days",
            "summarizeBy": "none"
          },
          {
            "name": "Delay Days",
            "dataType": "double",
            "sourceColumn": "Delay Days",
            "summarizeBy": "none"
          },
          {
            "name": "Delivery Performance",
            "dataType": "string",
            "sourceColumn": "Delivery Performance",
            "summarizeBy": "none"
          },
          {
            "name": "Delay Band",
            "dataType": "string",
            "sourceColumn": "Delay Band",
            "summarizeBy": "none",
            "sortByColumn": "Delay Sort"
          },
          {
            "name": "Delay Sort",
            "dataType": "int64",
            "sourceColumn": "Delay Sort",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Review Score",
            "dataType": "double",
            "sourceColumn": "Review Score",
            "summarizeBy": "none"
          },
          {
            "name": "Review Band",
            "dataType": "string",
            "sourceColumn": "Review Band",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Orders",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Encoded = Text.Combine({\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\"}),",
                "    Bytes = Binary.Decompress(Binary.FromText(Encoded, BinaryEncoding.Base64), Compression.GZip),",
                "    Source = Csv.Document(Bytes, [Delimiter=\",\", Columns=13, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Nulls = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(Nulls, {{\"Order ID\", Int64.Type},{\"Customer ID\", Int64.Type},{\"Purchase Date\", type date},{\"Status\", type text},{\"State\", type text},{\"City\", type text},{\"Delivery Days\", type number},{\"Delay Days\", type number},{\"Delivery Performance\", type text},{\"Delay Band\", type text},{\"Delay Sort\", Int64.Type},{\"Review Score\", type number},{\"Review Band\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Delivered Orders",
            "expression": "CALCULATE(COUNTROWS(Orders), KEEPFILTERS(Orders[Status] = \"delivered\"))",
            "formatString": "#,0",
            "displayFolder": "Overview",
            "description": "Distinct delivered orders; Orders has one row per order."
          },
          {
            "name": "Product Revenue",
            "expression": "CALCULATE(SUM(Items[Product Value]), KEEPFILTERS(Orders[Status] = \"delivered\"))",
            "formatString": "\"R$ \"#,0.00;(\"R$ \"#,0.00);\"R$ \"0.00",
            "displayFolder": "Overview",
            "description": "Sum of item prices on delivered orders, before freight. Dataset order value is not platform net revenue."
          },
          {
            "name": "Freight Value",
            "expression": "CALCULATE(SUM(Items[Freight Value]), KEEPFILTERS(Orders[Status] = \"delivered\"))",
            "formatString": "\"R$ \"#,0.00;(\"R$ \"#,0.00);\"R$ \"0.00",
            "displayFolder": "Overview",
            "description": "Freight Value"
          },
          {
            "name": "Total Order Value",
            "expression": "[Product Revenue] + [Freight Value]",
            "formatString": "\"R$ \"#,0.00;(\"R$ \"#,0.00);\"R$ \"0.00",
            "displayFolder": "Overview",
            "description": "Delivered product value plus freight; item totals are never joined to payment rows."
          },
          {
            "name": "Average Order Value",
            "expression": "DIVIDE([Total Order Value], [Delivered Orders])",
            "formatString": "\"R$ \"#,0.00;(\"R$ \"#,0.00);\"R$ \"0.00",
            "displayFolder": "Overview",
            "description": "Average Order Value"
          },
          {
            "name": "Items Sold",
            "expression": "CALCULATE(COUNTROWS(Items), KEEPFILTERS(Orders[Status] = \"delivered\"))",
            "formatString": "#,0",
            "displayFolder": "Overview",
            "description": "Items Sold"
          },
          {
            "name": "Customers",
            "expression": "CALCULATE(DISTINCTCOUNT(Orders[Customer ID]), KEEPFILTERS(Orders[Status] = \"delivered\"))",
            "formatString": "#,0",
            "displayFolder": "Overview",
            "description": "Real customer count based on customer_unique_id, rather than per-order customer_id."
          },
          {
            "name": "Average Review Score",
            "expression": "CALCULATE(AVERAGE(Orders[Review Score]), KEEPFILTERS(Orders[Status] = \"delivered\"))",
            "formatString": "0.00",
            "displayFolder": "Overview",
            "description": "Unweighted mean of the order-level review averages; missing reviews excluded."
          },
          {
            "name": "Reviewed Orders",
            "expression": "CALCULATE(COUNT(Orders[Review Score]), KEEPFILTERS(Orders[Status] = \"delivered\"))",
            "formatString": "#,0",
            "displayFolder": "Overview",
            "description": "Reviewed Orders"
          },
          {
            "name": "Review Coverage",
            "expression": "DIVIDE([Reviewed Orders], [Delivered Orders])",
            "formatString": "0.0%",
            "displayFolder": "Overview",
            "description": "Review Coverage"
          },
          {
            "name": "Measurable Deliveries",
            "expression": "CALCULATE([Delivered Orders], KEEPFILTERS(Orders[Delivery Performance] <> \"Not measurable\"))",
            "formatString": "#,0",
            "displayFolder": "Delivery",
            "description": "Measurable Deliveries"
          },
          {
            "name": "On-time Orders",
            "expression": "CALCULATE([Delivered Orders], KEEPFILTERS(Orders[Delivery Performance] = \"On time / early\"))",
            "formatString": "#,0",
            "displayFolder": "Delivery",
            "description": "On-time Orders"
          },
          {
            "name": "Late Orders",
            "expression": "CALCULATE([Delivered Orders], KEEPFILTERS(Orders[Delivery Performance] = \"Late\"))",
            "formatString": "#,0",
            "displayFolder": "Delivery",
            "description": "Late Orders"
          },
          {
            "name": "On-time Rate",
            "expression": "DIVIDE([On-time Orders], [Measurable Deliveries])",
            "formatString": "0.0%",
            "displayFolder": "Delivery",
            "description": "On-time Rate"
          },
          {
            "name": "Late Delivery Rate",
            "expression": "DIVIDE([Late Orders], [Measurable Deliveries])",
            "formatString": "0.0%",
            "displayFolder": "Delivery",
            "description": "Late Delivery Rate"
          },
          {
            "name": "Average Delivery Days",
            "expression": "CALCULATE(AVERAGE(Orders[Delivery Days]), KEEPFILTERS(Orders[Status] = \"delivered\"), KEEPFILTERS(Orders[Delivery Performance] <> \"Not measurable\"))",
            "formatString": "0.0",
            "displayFolder": "Delivery",
            "description": "Average Delivery Days"
          },
          {
            "name": "Low-review Orders",
            "expression": "CALCULATE([Reviewed Orders], KEEPFILTERS(Orders[Review Score] <= 2), KEEPFILTERS(NOT ISBLANK(Orders[Review Score])))",
            "formatString": "#,0",
            "displayFolder": "Delivery",
            "description": "Low-review Orders"
          },
          {
            "name": "Low-review Rate",
            "expression": "DIVIDE([Low-review Orders], [Reviewed Orders])",
            "formatString": "0.0%",
            "displayFolder": "Delivery",
            "description": "Low-review Rate"
          },
          {
            "name": "Repeat Customers",
            "expression": "VAR C = CALCULATETABLE(ADDCOLUMNS(VALUES(Orders[Customer ID]), \"__N\", CALCULATE(COUNTROWS(Orders))), KEEPFILTERS(Orders[Status] = \"delivered\")) RETURN COUNTROWS(FILTER(C, [__N] > 1))",
            "formatString": "#,0",
            "displayFolder": "Customers",
            "description": "Customers with at least two delivered orders inside the selected filter context; not a lifetime flag."
          },
          {
            "name": "Repeat Customer Rate",
            "expression": "DIVIDE([Repeat Customers], [Customers])",
            "formatString": "0.0%",
            "displayFolder": "Customers",
            "description": "Repeat Customer Rate"
          },
          {
            "name": "One-time Customers",
            "expression": "[Customers] - [Repeat Customers]",
            "formatString": "#,0",
            "displayFolder": "Customers",
            "description": "One-time Customers"
          },
          {
            "name": "Orders per Customer",
            "expression": "DIVIDE([Delivered Orders], [Customers])",
            "formatString": "0.00",
            "displayFolder": "Customers",
            "description": "Orders per Customer"
          },
          {
            "name": "Segment Customers",
            "expression": "SWITCH(SELECTEDVALUE('Customer Segment'[Segment]), \"Repeat\", [Repeat Customers], \"One-time\", [One-time Customers], [Customers])",
            "formatString": "#,0",
            "displayFolder": "Customers",
            "description": "Segment Customers"
          },
          {
            "name": "Freight Share",
            "expression": "DIVIDE([Freight Value], [Total Order Value])",
            "formatString": "0.0%",
            "displayFolder": "Sales",
            "description": "Freight Share"
          },
          {
            "name": "Active Sellers",
            "expression": "CALCULATE(DISTINCTCOUNT(Items[Seller ID]), KEEPFILTERS(Orders[Status] = \"delivered\"))",
            "formatString": "#,0",
            "displayFolder": "Sales",
            "description": "Active Sellers"
          },
          {
            "name": "Payment Value",
            "expression": "CALCULATE(SUM(Payments[Payment Value]), KEEPFILTERS(Orders[Status] = \"delivered\"))",
            "formatString": "\"R$ \"#,0.00;(\"R$ \"#,0.00);\"R$ \"0.00",
            "displayFolder": "Sales",
            "description": "Recorded payment value on delivered orders; may differ from item plus freight totals and is not recognised revenue."
          },
          {
            "name": "Payment Records",
            "expression": "CALCULATE(COUNTROWS(Payments), KEEPFILTERS(Orders[Status] = \"delivered\"))",
            "formatString": "#,0",
            "displayFolder": "Sales",
            "description": "Payment Records"
          },
          {
            "name": "Average Installments",
            "expression": "CALCULATE(AVERAGE(Payments[Installments]), KEEPFILTERS(Orders[Status] = \"delivered\"), KEEPFILTERS(Payments[Payment Method] = \"Credit card\"), KEEPFILTERS(Payments[Installments] > 0), KEEPFILTERS(Payments[Metadata Anomaly] = FALSE()))",
            "formatString": "0.0",
            "displayFolder": "Sales",
            "description": "Average Installments"
          },
          {
            "name": "Top Category Revenue",
            "expression": "VAR R = RANKX(ALLSELECTED(Items[Category]), [Product Revenue], , DESC, DENSE) RETURN IF(R <= 8, [Product Revenue])",
            "formatString": "\"R$ \"#,0.00;(\"R$ \"#,0.00);\"R$ \"0.00",
            "displayFolder": "Chart helpers",
            "description": "Top Category Revenue"
          },
          {
            "name": "Top State Value",
            "expression": "VAR R = RANKX(ALLSELECTED(Orders[State]), [Total Order Value], , DESC, DENSE) RETURN IF(R <= 8, [Total Order Value])",
            "formatString": "\"R$ \"#,0.00;(\"R$ \"#,0.00);\"R$ \"0.00",
            "displayFolder": "Chart helpers",
            "description": "Top State Value"
          },
          {
            "name": "Top State Customers",
            "expression": "VAR R = RANKX(ALLSELECTED(Orders[State]), [Customers], , DESC, DENSE) RETURN IF(R <= 8, [Customers])",
            "formatString": "#,0",
            "displayFolder": "Chart helpers",
            "description": "Top State Customers"
          },
          {
            "name": "Top Category Items",
            "expression": "VAR R = RANKX(ALLSELECTED(Items[Category]), [Items Sold], , DESC, DENSE) RETURN IF(R <= 8, [Items Sold])",
            "formatString": "#,0",
            "displayFolder": "Chart helpers",
            "description": "Top Category Items"
          },
          {
            "name": "Value MoM",
            "expression": "VAR P = CALCULATE([Total Order Value], DATEADD('Date'[Date], -1, MONTH)) RETURN IF(NOT ISBLANK(P) && P <> 0, DIVIDE([Total Order Value] - P, P))",
            "formatString": "0.0%",
            "displayFolder": "Sales",
            "description": "Value MoM"
          },
          {
            "name": "Card · Total Order Value",
            "expression": "VAR V = [Total Order Value] RETURN IF(ISBLANK(V), \"—\", \"R$ \" & FORMAT(DIVIDE(V, 1000000), \"0.00\") & \"M\")",
            "displayFolder": "Dashboard display",
            "isHidden": true,
            "description": "Card display only; underlying numeric measure remains available for charts, tables and analysis."
          },
          {
            "name": "Card · Delivered Orders",
            "expression": "VAR V = [Delivered Orders] RETURN IF(ISBLANK(V), \"—\", FORMAT(V, \"#,0\"))",
            "displayFolder": "Dashboard display",
            "isHidden": true,
            "description": "Card display only; underlying numeric measure remains available for charts, tables and analysis."
          },
          {
            "name": "Card · Average Order Value",
            "expression": "VAR V = [Average Order Value] RETURN IF(ISBLANK(V), \"—\", \"R$ \" & FORMAT(V, \"0.00\"))",
            "displayFolder": "Dashboard display",
            "isHidden": true,
            "description": "Card display only; underlying numeric measure remains available for charts, tables and analysis."
          },
          {
            "name": "Card · On-time Rate",
            "expression": "VAR V = [On-time Rate] RETURN IF(ISBLANK(V), \"—\", FORMAT(V, \"0.0%\"))",
            "displayFolder": "Dashboard display",
            "isHidden": true,
            "description": "Card display only; underlying numeric measure remains available for charts, tables and analysis."
          },
          {
            "name": "Card · Average Review Score",
            "expression": "VAR V = [Average Review Score] RETURN IF(ISBLANK(V), \"—\", FORMAT(V, \"0.00\"))",
            "displayFolder": "Dashboard display",
            "isHidden": true,
            "description": "Card display only; underlying numeric measure remains available for charts, tables and analysis."
          },
          {
            "name": "Card · Customers",
            "expression": "VAR V = [Customers] RETURN IF(ISBLANK(V), \"—\", FORMAT(V, \"#,0\"))",
            "displayFolder": "Dashboard display",
            "isHidden": true,
            "description": "Card display only; underlying numeric measure remains available for charts, tables and analysis."
          },
          {
            "name": "Card · Repeat Customer Rate",
            "expression": "VAR V = [Repeat Customer Rate] RETURN IF(ISBLANK(V), \"—\", FORMAT(V, \"0.0%\"))",
            "displayFolder": "Dashboard display",
            "isHidden": true,
            "description": "Card display only; underlying numeric measure remains available for charts, tables and analysis."
          },
          {
            "name": "Card · Average Delivery Days",
            "expression": "VAR V = [Average Delivery Days] RETURN IF(ISBLANK(V), \"—\", FORMAT(V, \"0.0\"))",
            "displayFolder": "Dashboard display",
            "isHidden": true,
            "description": "Card display only; underlying numeric measure remains available for charts, tables and analysis."
          },
          {
            "name": "Card · Review Coverage",
            "expression": "VAR V = [Review Coverage] RETURN IF(ISBLANK(V), \"—\", FORMAT(V, \"0.0%\"))",
            "displayFolder": "Dashboard display",
            "isHidden": true,
            "description": "Card display only; underlying numeric measure remains available for charts, tables and analysis."
          },
          {
            "name": "Card · Product Revenue",
            "expression": "VAR V = [Product Revenue] RETURN IF(ISBLANK(V), \"—\", \"R$ \" & FORMAT(DIVIDE(V, 1000000), \"0.00\") & \"M\")",
            "displayFolder": "Dashboard display",
            "isHidden": true,
            "description": "Card display only; underlying numeric measure remains available for charts, tables and analysis."
          },
          {
            "name": "Card · Freight Value",
            "expression": "VAR V = [Freight Value] RETURN IF(ISBLANK(V), \"—\", \"R$ \" & FORMAT(DIVIDE(V, 1000000), \"0.00\") & \"M\")",
            "displayFolder": "Dashboard display",
            "isHidden": true,
            "description": "Card display only; underlying numeric measure remains available for charts, tables and analysis."
          },
          {
            "name": "Card · Items Sold",
            "expression": "VAR V = [Items Sold] RETURN IF(ISBLANK(V), \"—\", FORMAT(V, \"#,0\"))",
            "displayFolder": "Dashboard display",
            "isHidden": true,
            "description": "Card display only; underlying numeric measure remains available for charts, tables and analysis."
          },
          {
            "name": "Card · Freight Share",
            "expression": "VAR V = [Freight Share] RETURN IF(ISBLANK(V), \"—\", FORMAT(V, \"0.0%\"))",
            "displayFolder": "Dashboard display",
            "isHidden": true,
            "description": "Card display only; underlying numeric measure remains available for charts, tables and analysis."
          },
          {
            "name": "Card · Active Sellers",
            "expression": "VAR V = [Active Sellers] RETURN IF(ISBLANK(V), \"—\", FORMAT(V, \"#,0\"))",
            "displayFolder": "Dashboard display",
            "isHidden": true,
            "description": "Card display only; underlying numeric measure remains available for charts, tables and analysis."
          },
          {
            "name": "Card · Repeat Customers",
            "expression": "VAR V = [Repeat Customers] RETURN IF(ISBLANK(V), \"—\", FORMAT(V, \"#,0\"))",
            "displayFolder": "Dashboard display",
            "isHidden": true,
            "description": "Card display only; underlying numeric measure remains available for charts, tables and analysis."
          },
          {
            "name": "Card · Orders per Customer",
            "expression": "VAR V = [Orders per Customer] RETURN IF(ISBLANK(V), \"—\", FORMAT(V, \"0.00\"))",
            "displayFolder": "Dashboard display",
            "isHidden": true,
            "description": "Card display only; underlying numeric measure remains available for charts, tables and analysis."
          },
          {
            "name": "Card · Measurable Deliveries",
            "expression": "VAR V = [Measurable Deliveries] RETURN IF(ISBLANK(V), \"—\", FORMAT(V, \"#,0\"))",
            "displayFolder": "Dashboard display",
            "isHidden": true,
            "description": "Card display only; underlying numeric measure remains available for charts, tables and analysis."
          },
          {
            "name": "Card · Late Orders",
            "expression": "VAR V = [Late Orders] RETURN IF(ISBLANK(V), \"—\", FORMAT(V, \"#,0\"))",
            "displayFolder": "Dashboard display",
            "isHidden": true,
            "description": "Card display only; underlying numeric measure remains available for charts, tables and analysis."
          },
          {
            "name": "Card · Low-review Rate",
            "expression": "VAR V = [Low-review Rate] RETURN IF(ISBLANK(V), \"—\", FORMAT(V, \"0.0%\"))",
            "displayFolder": "Dashboard display",
            "isHidden": true,
            "description": "Card display only; underlying numeric measure remains available for charts, tables and analysis."
          }
        ]
      },
      {
        "name": "Items",
        "columns": [
          {
            "name": "Order ID",
            "dataType": "int64",
            "sourceColumn": "Order ID",
            "summarizeBy": "none",
            "isHidden": true,
            "description": "Compact internal key. Original source identifier is preserved in SourceKeys/Order_ID_mapping.csv."
          },
          {
            "name": "Item Number",
            "dataType": "int64",
            "sourceColumn": "Item Number",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Product ID",
            "dataType": "int64",
            "sourceColumn": "Product ID",
            "summarizeBy": "none",
            "isHidden": true,
            "description": "Compact internal key. Original source identifier is preserved in SourceKeys/Product_ID_mapping.csv."
          },
          {
            "name": "Seller ID",
            "dataType": "int64",
            "sourceColumn": "Seller ID",
            "summarizeBy": "none",
            "isHidden": true,
            "description": "Compact internal key. Original source identifier is preserved in SourceKeys/Seller_ID_mapping.csv."
          },
          {
            "name": "Seller State",
            "dataType": "string",
            "sourceColumn": "Seller State",
            "summarizeBy": "none"
          },
          {
            "name": "Category",
            "dataType": "string",
            "sourceColumn": "Category",
            "summarizeBy": "none"
          },
          {
            "name": "Product Value",
            "dataType": "decimal",
            "sourceColumn": "Product Value",
            "summarizeBy": "none"
          },
          {
            "name": "Freight Value",
            "dataType": "decimal",
            "sourceColumn": "Freight Value",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Items",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Encoded = Text.Combine({\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\"}),",
                "    Bytes = Binary.Decompress(Binary.FromText(Encoded, BinaryEncoding.Base64), Compression.GZip),",
                "    Source = Csv.Document(Bytes, [Delimiter=\",\", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Nulls = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(Nulls, {{\"Order ID\", Int64.Type},{\"Item Number\", Int64.Type},{\"Product ID\", Int64.Type},{\"Seller ID\", Int64.Type},{\"Seller State\", type text},{\"Category\", type text},{\"Product Value\", Currency.Type},{\"Freight Value\", Currency.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "Payments",
        "columns": [
          {
            "name": "Order ID",
            "dataType": "int64",
            "sourceColumn": "Order ID",
            "summarizeBy": "none",
            "isHidden": true,
            "description": "Compact internal key. Original source identifier is preserved in SourceKeys/Order_ID_mapping.csv."
          },
          {
            "name": "Sequence",
            "dataType": "int64",
            "sourceColumn": "Sequence",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Payment Method",
            "dataType": "string",
            "sourceColumn": "Payment Method",
            "summarizeBy": "none"
